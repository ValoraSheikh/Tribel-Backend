generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  avatar     String?
  createdAt  DateTime   @default(now())
  firstName  String
  lastName   String?
  phoneNo    String?
  role       UserRole   @default(Guest)
  updatedAt  DateTime   @updatedAt
  auth0Id    String     @unique
  beds       Bed[]
  bookings   Booking[]
  payments   Payment[]
  properties Property[]
  tenant     Tenant?
}

model Tenant {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  userId      String     @unique
  description String?
  profile     String?
  currency    String     @default("INR")
  timezone    String     @default("Asia/Kolkata")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  properties  Property[]
  user        User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Property {
  id            String         @id @default(uuid())
  tenantId      String
  type          String?
  address       String
  gstin         String?
  city          String
  state         String
  country       String
  postal_code   String
  contact_email String
  contact_phone String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  images        String[]
  latitude      Float
  longitude     Float
  amenities     Json?
  description   String?
  title         String
  starRating    Float?
  adminId       String
  bookings      Booking[]
  admin         User           @relation(fields: [adminId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  reviews       Reviews[]
  rooms         Room[]
  roomTemplate  RoomTemplate[]

  @@index([tenantId])
  @@index([adminId])
}

model Reviews {
  id         String    @id @default(uuid())
  rating     Int
  comment    String?
  propertyId String
  bookingId  String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
  property   Property  @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

model RoomTemplate {
  id            String    @id @default(uuid())
  propertyId    String
  title         String
  description   String?
  bedsPerRoom   Int
  numberOfRooms Int
  pricePerBed   Int
  type          String
  amenities     Json?
  image         String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  rooms         Room[]
  property      Property  @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

model Room {
  id             String       @id @default(uuid())
  propertyId     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  bedCount       Int
  description    String?
  pricePerBed    Decimal      @db.Decimal(12, 2)
  roomTemplateId String
  title          String
  batchId        String?
  beds           Bed[]
  bookings       Booking[]
  property       Property     @relation(fields: [propertyId], references: [id])
  roomTemplate   RoomTemplate @relation(fields: [roomTemplateId], references: [id])

  @@index([roomTemplateId, batchId])
  @@index([propertyId])
  @@index([batchId])
}

model Bed {
  id        String    @id @default(uuid())
  roomId    String
  bedNo     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  userId    String?
  room      Room      @relation(fields: [roomId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])
  bookings  Booking[]

  @@index([roomId])
}

model Booking {
  id            String        @id @default(uuid())
  propertyId    String
  roomId        String
  guestId       String
  status        BookingStatus @default(PENDING)
  totalPrice    Decimal       @db.Decimal(12, 2)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  cancelledAt   DateTime?
  bedId         String
  invoiceId     String?
  paymentStatus PaymentStatus
  paymentMode   PaymentMode
  bed           Bed           @relation(fields: [bedId], references: [id])
  guest         User          @relation(fields: [guestId], references: [id])
  property      Property      @relation(fields: [propertyId], references: [id])
  room          Room          @relation(fields: [roomId], references: [id])
  invoice       Invoice?
  payments      Payment[]

  @@index([propertyId, roomId, guestId])
  @@index([propertyId])
  @@index([roomId])
  @@index([bedId])
  @@index([startDate, endDate])
  @@index([paymentMode, paymentStatus])
}

model Invoice {
  id          String        @id @default(uuid())
  bookingId   String        @unique
  paymentId   String?       @unique
  invoiceNo   String        @unique
  subtotal    Decimal       @db.Decimal(12, 2)
  taxAmount   Decimal       @db.Decimal(12, 2)
  totalAmount Decimal       @db.Decimal(12, 2)
  pdfUrl      String?
  status      InvoiceStatus @default(PENDING)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  booking     Booking       @relation(fields: [bookingId], references: [id])
}

model Payment {
  id                String          @id @default(uuid())
  bookingId         String
  guestId           String
  provider          PaymentProvider
  status            PaymentStatus   @default(PENDING)
  amount            Decimal         @db.Decimal(12, 2)
  currency          String          @default("INR")
  razorpayOrderId   String?         @unique
  razorpayPaymentId String?         @unique
  razorpayRefundId  String?         @unique
  razorpaySignature String?
  offlineReference  String?
  verifiedById      String?
  verifiedAt        DateTime?
  paidAt            DateTime?
  failureReason     String?
  metadata          Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  booking           Booking         @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  guest             User            @relation(fields: [guestId], references: [id])

  @@index([bookingId])
  @@index([guestId])
  @@index([status, createdAt])
  @@index([provider, status])
}

model PaymentEvent {
  id          String    @id
  provider    String
  eventType   String
  paymentId   String?
  razorpayId  String?   @unique
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([provider, eventType])
  @@index([processed, createdAt])
}

model IdempotencyKey {
  key            String   @id @unique
  userId         String
  path           String
  responseStatus Int
  reponsesBody   Json
  createdAt      DateTime @default(now())
  method         String   @default("POST")

  @@index([userId])
}

enum UserRole {
  Guest
  Staff
  Admin
  Super_Admin
}

enum InvoiceStatus {
  PENDING
  GENERATED
  FAILED
}

enum PaymentMode {
  ONLINE
  OFFLINE
}

enum PaymentProvider {
  RAZORPAY
  CASH
  UPI
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  PENDING_APPROVAL
  FAILED
  PARTIALLY_PAID
  REJECTED
  REFUNDED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  REJECTED
}
