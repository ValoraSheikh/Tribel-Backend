generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
  previewFeatures = ["fullTextSearchPostgres"]
}

datasource db {
  provider = "postgresql"
}

model User {
  id         String     @id @default(uuid())
  email      String     @unique
  avatar     String?
  createdAt  DateTime   @default(now())
  firstName  String
  lastName   String?
  phoneNo    String?
  role       UserRole   @default(Guest)
  updatedAt  DateTime   @updatedAt
  auth0Id    String     @unique
  beds       Bed[]
  bookings   Booking[]
  properties Property[]
  tenant     Tenant?
}

model Tenant {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  userId      String     @unique
  description String?
  profile     String?
  currency    String     @default("INR")
  timezone    String     @default("Asia/Kolkata")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?
  properties  Property[]
  user        User       @relation(fields: [userId], references: [id])

  @@index([userId])
}

model Property {
  id            String         @id @default(uuid())
  tenantId      String
  type          String?
  address       String
  gstin         String?
  city          String
  state         String
  country       String
  postal_code   String
  contact_email String
  contact_phone String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  images        String[]
  latitude      Float
  longitude     Float
  amenities     Json?
  description   String?
  title         String
  starRating    Float?
  adminId       String
  bookings      Booking[]
  admin         User           @relation(fields: [adminId], references: [id])
  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  rooms         Room[]
  roomTemplate  RoomTemplate[]

  @@index([tenantId])
  @@index([adminId])
}

model RoomTemplate {
  id            String    @id @default(uuid())
  propertyId    String
  title         String
  description   String?
  bedsPerRoom   Int
  numberOfRooms Int
  pricePerBed   Int
  type          String
  amenities     Json?
  image         String
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  rooms         Room[]
  property      Property  @relation(fields: [propertyId], references: [id])

  @@index([propertyId])
}

model Room {
  id             String       @id @default(uuid())
  propertyId     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
  bedCount       Int
  description    String?
  pricePerBed    Int
  roomTemplateId String
  title          String
  batchId        String?
  beds           Bed[]
  bookings       Booking[]
  property       Property     @relation(fields: [propertyId], references: [id])
  roomTemplate   RoomTemplate @relation(fields: [roomTemplateId], references: [id])

  @@index([roomTemplateId, batchId])
  @@index([propertyId])
  @@index([batchId])
}

model Bed {
  id        String    @id @default(uuid())
  roomId    String
  bedNo     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  userId    String?
  room      Room      @relation(fields: [roomId], references: [id])
  user      User?     @relation(fields: [userId], references: [id])
  bookings  Booking[]

  @@index([roomId])
}

model Booking {
  id          String        @id @default(uuid())
  propertyId  String
  roomId      String
  guestId     String
  status      BookingStatus @default(UPCOMING)
  totalPrice  Float
  startDate   DateTime
  endDate     DateTime
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  cancelledAt DateTime?
  bedId       String
  bed         Bed           @relation(fields: [bedId], references: [id])
  guest       User          @relation(fields: [guestId], references: [id])
  property    Property      @relation(fields: [propertyId], references: [id])
  room        Room          @relation(fields: [roomId], references: [id])

  @@index([propertyId, roomId, guestId])
  @@index([propertyId])
  @@index([roomId])
  @@index([bedId])
  @@index([startDate, endDate])
}

model IdempotencyKey {
  key            String   @id @unique
  userId         String
  path           String
  responseStatus Int
  reponsesBody   Json
  createdAt      DateTime @default(now())
  method         String   @default("POST")

  @@index([userId])
}

enum UserRole {
  Guest
  Staff
  Admin
  Super_Admin
}

enum BookingStatus {
  UPCOMING
  ONGOING
  CONFIRMED
  CANCELLED
}
