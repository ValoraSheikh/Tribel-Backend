# Frontend origin (used for post-login / post-logout redirects)
# Production: https://tribel.in
# Local:      http://localhost:3001
FRONTEND_URL=http://localhost:3001

# Cookie domain for the Auth0 session cookie.
# Production: set to .tribel.in so tribel.in and api.tribel.in share the session.
# Local:      leave UNSET (host-only cookie on localhost).
# COOKIE_DOMAIN=.tribel.in

# Auth0
# CLIENT_SECRET=<secret>
# BASE_URL=<backend public origin, no trailing slash>
# CLIENT_ID=<client id>
# ISSUER_BASE_URL=<tenant>.auth0.com

# CORS origin for the frontend (comma-separated list allowed)
CORS_ORIGIN=http://localhost:3001
PORT=5000
